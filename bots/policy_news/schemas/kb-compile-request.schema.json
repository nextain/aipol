{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipol.kaps.or.kr/schemas/policy-news/kb-compile-request-v1.json",
  "title": "naia-kb-compiler compatible CompileInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources", "safety", "lowConfidenceThreshold"],
  "properties": {
    "sources": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "uri", "title", "text"],
        "properties": {
          "kind": {"enum": ["url", "text"]}, "uri": {"type": "string"},
          "title": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "safety": {"const": "block"},
    "lowConfidenceThreshold": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
