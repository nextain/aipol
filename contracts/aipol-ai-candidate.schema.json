{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipol.kaps.or.kr/contracts/aipol-ai-candidate.schema.json",
  "title": "AIPOL E2 AI candidate approval request",
  "$comment": "Request body for POST /api/admin/aipol/experiments/{experiment_id}/ai-candidates. The approved public response uses aipol-ai-candidate-approved-public.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_role", "artifact_id", "artifact_version", "content", "model", "deployment", "prompt_version", "generated_at", "evidence_refs", "approval_id", "approved_by"],
  "allOf": [
    {
      "if": {"properties": {"candidate_role": {"const": "primary"}}},
      "then": {"required": ["m2_aggregate_hash"], "properties": {"m2_aggregate_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
      "else": {"properties": {"m2_aggregate_hash": {"type": "null"}}}
    }
  ],
  "properties": {
    "candidate_role": {"enum": ["primary", "fallback"]},
    "artifact_id": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "artifact_version": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "body": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
      }
    },
    "model": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "deployment": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "prompt_version": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "generated_at": {"type": "string", "format": "date-time"},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}},
    "m2_aggregate_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "approval_id": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "approved_by": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
  }
}
